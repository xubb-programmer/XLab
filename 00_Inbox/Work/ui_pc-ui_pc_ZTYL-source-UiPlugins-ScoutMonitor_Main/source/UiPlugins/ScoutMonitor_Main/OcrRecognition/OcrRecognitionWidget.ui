	height:31px;
	border-image: url(:/resource/下拉框-iconBtn-normal.png);
}
QComboBox#Type_comboBox::drop-down::hover
{
	width:35px;
	height:31px;
	border-image: url(:/resource/下拉框-iconBtn_hover-select.png);
}
QComboBox#Type_comboBox::drop-down::checked
{
	width:35px;
	height:31px;
	border-image: url(:/resource/下拉框-iconBtn_pressed.png);
}
QComboBox#Type_comboBox::drop-down::disabled
{
	width:0px;
	height:0px;
}

QComboBox#Type_comboBox QAbstractItemView
{	
	font:18px &quot;阿里巴巴普惠体&quot;;
