QComboBox#Type_comboBox
{
    border: 1px solid;
    padding:1px 1px 1px 1px;
    combobox-popup:0;
    font:18px &quot;阿里巴巴普惠体&quot;;
    color:white;
	background-color: rgba(36, 74, 106, 7%);
	border: 1px solid #41c2ff;
}

QComboBox#Type_comboBox::disabled
