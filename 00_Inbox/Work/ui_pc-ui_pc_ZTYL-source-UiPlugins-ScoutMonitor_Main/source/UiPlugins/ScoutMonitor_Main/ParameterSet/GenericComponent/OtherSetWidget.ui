}
QComboBox#comboBox_Car::drop-down
{
	width:30px;
	height:37px;
	border-image: url(:/resource/下拉框-iconBtn_下拉-normal.png);
}
QComboBox#comboBox_Car::drop-down::hover
{
	width:30px;
	height:37px;
	border-image: url(:/resource/下拉框-iconBtn_下拉-hover-select.png);
}
QComboBox#comboBox_Car::drop-down::checked
{
	width:30px;
	height:37px;
	border-image: url(:/resource/下拉框-iconBtn_下拉-pressed.png);
}
QComboBox#comboBox_Car QAbstractItemView
{	
	font:20px &quot;阿里巴巴普惠体&quot;;
