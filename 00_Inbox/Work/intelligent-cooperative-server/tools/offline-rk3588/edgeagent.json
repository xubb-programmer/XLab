{
  "config_version": 2,
  "node_id": "intelligent_cooperative_server_edge",
  "broker": {
    "host": "127.0.0.1",
    "port": 1883,
    "protocol": "mqtt311",
    "keepalive_s": 30,
    "clean_session": true
  },
  "channels": [
    {
      "channel_id": "target-input-udp",
      "enabled": true,
      "type": "udp",
      "bind_address": "0.0.0.0",
      "bind_port": 28080,
      "allowed_peers": ["0.0.0.0:0"],
      "max_datagram_bytes": 65507,
      "multicast": { "enabled": false }
    },
    {
      "channel_id": "device-status-udp",
      "enabled": true,
      "type": "udp",
      "bind_address": "0.0.0.0",
      "bind_port": 5678,
      "allowed_peers": ["0.0.0.0:0"],
      "max_datagram_bytes": 65507,
      "multicast": {
        "enabled": true,
        "group": "239.255.0.1",
        "interface": "auto"
      }
    },
    {
      "channel_id": "firepower-action-tcp",
      "type": "tcp",
      "role": "client",
      "remote_host": "dynamic",
      "remote_port": 5567,
      "frame": { "kind": "delimiter", "delimiter": "\n" }
    },
    {
      "channel_id": "fire-01-tcp",
      "type": "tcp",
      "role": "client",
      "remote_host": "dynamic",
      "remote_port": 5567,
      "frame": { "kind": "delimiter", "delimiter": "\n" }
    },
    {
      "channel_id": "fire-02-tcp",
      "type": "tcp",
      "role": "client",
      "remote_host": "dynamic",
      "remote_port": 5567,
      "frame": { "kind": "delimiter", "delimiter": "\n" }
    }
  ],
  "devices": [
    { "device_id": "target-input-device", "channel_id": "target-input-udp", "qos": 0, "message_format": "json" },
    { "device_id": "device-status-device", "channel_id": "device-status-udp", "qos": 0, "message_format": "json" },
    { "device_id": "firepower-action-device", "channel_id": "firepower-action-tcp", "qos": 1, "message_format": "json" },
    { "device_id": "fire-01-device", "channel_id": "fire-01-tcp", "qos": 1, "message_format": "json" },
    { "device_id": "fire-02-device", "channel_id": "fire-02-tcp", "qos": 1, "message_format": "json" }
  ]
}
