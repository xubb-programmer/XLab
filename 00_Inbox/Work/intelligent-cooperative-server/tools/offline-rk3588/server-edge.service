[Unit]
Description=Intelligent Cooperative Server EdgeAgent Gateway
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
User=intelligent-cooperative-server
Group=intelligent-cooperative-server
WorkingDirectory=/opt/jw/intelligent-cooperative-server/current/web
Environment=EDGEAGENT_LOG_FILE=/opt/jw/intelligent-cooperative-server/current/web/dist/edge/edgeagent.log
ExecStart=/opt/jw/intelligent-cooperative-server/current/bin/edgeagent --config config/edgeagent.json
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
